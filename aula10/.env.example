# Copie para .env (PowerShell: copy .env.example .env) e preencha. O .env NÃO vai para o git.
PROVEDOR=openai
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Ollama (só se PROVEDOR=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# Token que autoriza a ESCRITA no seu MCP Server (Etapa 9). Nunca escreva o valor no código.
TOKEN_REGISTRO=troque-este-valor
