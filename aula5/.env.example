# Copie para .env e ajuste. Provedor: "openai" (padrão) ou "ollama" (local, grátis)
PROVEDOR=openai

# Ollama: o provedor.py NAO le OLLAMA_MODEL -- o Agents SDK usa OPENAI_DEFAULT_MODEL
# como nome do modelo. Com PROVEDOR=ollama, ajuste OPENAI_DEFAULT_MODEL=llama3.1.
# Dentro do Docker (servico 'agente'), use OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# OpenAI (só se PROVEDOR=openai)
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Conexões dos bancos (usadas pelos MCP Servers)
PG_HOST=127.0.0.1
PG_PORT=5434
PG_USER=postgres
PG_PASSWORD=Postgres@12345
PG_DATABASE=cisp_ocorrencias

MSSQL_HOST=127.0.0.1
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=YourStrong@Password123
MSSQL_DATABASE=cisp_operacoes

# URLs dos MCP Servers quando rodando via Streamable HTTP (Bloco 5 / Docker)
MCP_OCORRENCIAS_URL=http://localhost:8001/mcp
MCP_OPERACOES_URL=http://localhost:8002/mcp
MCP_SERVICOS_URL=http://localhost:8003/mcp

# Bloco 6: planilha de eventos (Google Sheets publicada como CSV).
# Deixe vazio para usar a cópia local dados/eventos.csv.
EVENTOS_CSV_URL=

MQTT_BROKER=broker.emqx.io
MQTT_PORT=1883
MQTT_PREFIXO=pcdf/molina