# Copie para .env (PowerShell: copy .env.example .env) e ajuste.
# Provedor: "mock" (sem chave e sem internet), "openai", "ollama" ou "claude".
# Vazio = cada exemplo usa o seu padrão: os exemplos 09, 10 e 11 e os desafios usam openai (LLM real); os demais, mock.
# Se o provedor real não puder ser usado (sem chave, Ollama fora do ar), cai no Mock com aviso.
PROVEDOR=openai

# OpenAI (só se PROVEDOR=openai)
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Ollama (só se PROVEDOR=ollama; local e grátis) -- o modelo precisa estar baixado (ollama pull llama3.1)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# Claude (só se PROVEDOR=claude) -- opcional
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# JEV (Jev AI): modelo de decisões tipadas, usado no desafio 3. A chave NUNCA vai no código. Cada pergunta = 1 crédito.
# Sem a chave, o desafio 3 usa um JEV de mentira (JevMock).
JEV_AI_API_KEY=
