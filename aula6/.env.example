# Copie para .env (PowerShell: copy .env.example .env) e ajuste.
# Provedor: "mock" (padrão, sem chave e sem internet), "openai", "ollama" ou "claude"
PROVEDOR=mock

# OpenAI (só se PROVEDOR=openai)
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Ollama (só se PROVEDOR=ollama; local e grátis) -- o modelo precisa estar baixado (ollama pull llama3.1)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# Claude (só se PROVEDOR=claude) -- opcional
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
