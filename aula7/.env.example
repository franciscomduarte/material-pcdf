# Copie para .env (PowerShell: copy .env.example .env) e ajuste.
# Na Aula 7 TODOS os exemplos, exercícios e desafios usam LLM REAL (não há Mock).
# Escolha UM provedor: "openai" (padrão, como nas Aulas 4 e 5) ou "ollama" (local e grátis).
PROVEDOR=openai

# OpenAI (só se PROVEDOR=openai). A chave NUNCA vai no código.
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Ollama (só se PROVEDOR=ollama): `ollama serve` no ar e o modelo baixado (ex.: ollama pull llama3.1)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# (provedor.py também aceita PROVEDOR=claude com ANTHROPIC_API_KEY e ANTHROPIC_MODEL)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
