# Copie para .env e preencha. NUNCA faça commit do .env.

# --- Provedor de modelo: openai ou ollama ---
PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Ollama (local, grátis): precisa de `ollama serve` e `ollama pull llama3.1`
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# --- Langfuse (use o Cloud: https://cloud.langfuse.com) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- OpenTelemetry / Prometheus / OPA ---
OTEL_SERVICE_NAME=aula9-agents
PROMETHEUS_PORT=8000
OPA_URL=http://localhost:8181
